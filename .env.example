# =============================================================
#  CRYPTO AGENT — Variables de entorno
#  Copiá este archivo como .env y completá los valores.
#  NUNCA subas .env a GitHub.
#  Las mismas variables deben estar en Railway (Settings → Variables).
# =============================================================

# ── Binance ───────────────────────────────────────────────────
BINANCE_API_KEY=tu_key_aqui
BINANCE_API_SECRET=tu_secret_aqui
BINANCE_TESTNET=true          # true = Testnet | false = dinero real

# ── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# ── GitHub Gist (dashboard remoto) ────────────────────────────
# Crear token en: https://github.com/settings/tokens → scope "gist"
# El GIST_ID se obtiene al crear el primer gist
GITHUB_GIST_TOKEN=ghp_...
GITHUB_GIST_ID=abc123...

# ── API interna ───────────────────────────────────────────────
AGENT_API_TOKEN=               # protege /api/close — dejar vacío para deshabilitar
PORT=8080                      # Railway lo sobreescribe automáticamente

# ── Riesgo por operación ──────────────────────────────────────
MAX_TRADE_USD=300              # USD por trade (Railway: 300)
MAX_DAILY_LOSS_USD=30          # Agente se detiene si pierde esto en el día
MAX_OPEN_POSITIONS=6           # Cap global (suma de todas las cuotas)

# ── Cuotas por estrategia ─────────────────────────────────────
MAX_OPEN_TREND=2               # TREND: Claude + HMM
MAX_OPEN_GRID=3                # GRID: mean-reversion (uno por símbolo)
# MOMENTUM: controlado por GROUP_B_MAX_POSITIONS más abajo

# ── Señales ───────────────────────────────────────────────────
MIN_SIGNAL_CONVICTION=8        # Convicción mínima Claude (1-10)

# ── Intervalos ────────────────────────────────────────────────
MONITOR_INTERVAL_MINUTES=15    # Frecuencia de check SL/TP (prod: 15)
ANALYSIS_INTERVAL_MINUTES=240  # Frecuencia de análisis Claude (prod: 240)

# ── Pares principales (Grupo A) ───────────────────────────────
# SYMBOLS no es env var — se edita directo en config.py

# ── Grupo B — altcoins top movers ─────────────────────────────
GROUP_B_ENABLED=true
GROUP_B_MAX_POSITIONS=1
GROUP_B_TOP_MOVERS=2
GROUP_B_MIN_CHANGE_PCT=5.0     # % mínimo de movimiento 24h para calificar
GROUP_B_MIN_VOLUME_USD=50000000
STOP_LOSS_PCT_B=0.03
TAKE_PROFIT_PCT_B=0.15

# ── Grid Trading (mean-reversion) ────────────────────────────
GRID_ENABLED=true
GRID_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT   # agregar pares acá (Railway)
GRID_N_LEVELS=8                # niveles totales (geométrico)
GRID_LOOKBACK_DAYS=60          # días de historia para calcular rango
GRID_STEP_PCT=0.025            # 2.5% entre niveles → TP ≈ SL ≈ 2.5%
